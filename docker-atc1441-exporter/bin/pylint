#!/usr/bin/env bash
set -euo pipefail

# pybluez's `bluetooth` C extension is Linux/BlueZ-only and is not installed on
# macOS (see the sys_platform marker in pyproject.toml), so pylint cannot
# resolve it there. Ignore that module on macOS only; on Linux the import
# resolves and is linted as-is.
extra=()
if [ "$(uname -s)" = Darwin ]; then
    extra=(--ignored-modules=bluetooth)
fi

# pybluez==0.23 only builds under setuptools<58, which itself cannot run on
# Python 3.13+. Pin the interpreter to the project's floor (3.9) so the venv
# builds; --python overrides an inherited UV_PYTHON (set to a newer version in
# CI).
exec uv run --python 3.9 --frozen pylint "${extra[@]}" "$@"
