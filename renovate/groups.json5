{
    "packageRules": [
        {
            "groupName": "com.google.auto.value",
            "matchManagers": ["gradle", "maven"],
            "matchDepNames": [
                "/^com\\.google\\.auto\\.value.*$/",
            ],
        },
        {
            "groupName": "elasticsearch",
            "matchDepNames": [
                "/^docker\\.elastic\\.co/kibana/kibana/",
                "/^elasticsearch/",
                "/^org\\.elasticsearch\\.client/",
            ],
        },
        {
            "groupName": "gcsfs",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^fsspec$/",
                "/^gcsfs$/",
            ],
        },
        {
            "groupName": "google",
            "matchDatasources": ["terraform-module", "terraform-provider"],
            "matchDepNames": [
                "/^google$/",
                "/^google-beta$/",
            ],
        },
        {
            "groupName": "grpcio",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^grpcio/",
            ],
        },
        {
            "groupName": "kubernetes",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^kubernetes$/",
                "/^kubernetes-asyncio$/",
            ],
        },
        {
            "groupName": "mkl",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^intel-openmp$/",
                "/^mkl$/",
            ],
        },
        {
            "groupName": "n8n",
            "matchDepNames": [
                "/^docker\\.io/n8nio/runners$/",
                "/^docker\\.n8n\\.io/n8nio/n8n$/",
            ],
        },
        {
            // Merge builtin `opentelemetry-python` and
            // `opentelemetry-python-contrib` groups, since they have exact
            // version pins on each other.
            // If/when they start doing wider ranges, delete this group.
            "groupName": "opentelemetry",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^opentelemetry-/",
                "/^opentelemetry$/",
            ],
            "ignoreUnstable": false,
        },
        {
            "groupName": "org.apache.beam",
            "matchManagers": ["gradle", "maven"],
            "matchDepNames": [
                "/^org\\.apache\\.beam.*$/",
                "/^apache-beam$/",
                "/^beam_python..._sdk$/",
            ],
        },
        {
            "groupName": "org.apache.hadoop",
            "matchManagers": ["gradle", "maven"],
            "matchDepNames": [
                "/^org\\.apache\\.hadoop.*$/",
            ],
        },
        {
            "groupName": "org.jetbrains.kotlin",
            "matchManagers": ["gradle", "maven"],
            "matchDepNames": [
                "/^org\\.jetbrains\\.kotlin.*$/",
            ],
        },
        {
            "groupName": "org.junit.jupiter",
            "matchManagers": ["gradle", "maven"],
            "matchDepNames": [
                "/^org\\.junit\\.jupiter:.*$/",
            ],
        },
        {
            "groupName": "pandas",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/pandas/",
                "/pandas-stubs/",
            ],
        },
        {
            "groupName": "pydantic",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^pydantic$/",
                "/^pydantic-core$/",
            ],
        },
        {
            "groupName": "pylint",
            "matchDepNames": [
                "/^PyCQA/pylint$/",
                "/^pycqa/pylint$/",
                "/^pylint$/",
            ],
        },
        {
            "groupName": "python",
            "matchDepNames": [
                "/^cimg/python$/",
                "/^python$/",
                "/^python/cpython$/",
            ],
        },
        {
            "groupName": "pytorch",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^torch$/",
                "/^torchaudio$/",
                "/^torchvision$/",
            ],
        },
        {
            "groupName": "sanic",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^sanic$/",
                "/^sanic-testing$/",
            ],
        },
        {
            "groupName": "tensorrt-cu12",
            "matchDatasources": ["pypi"],
            "matchDepNames": [
                "/^tensorrt-cu12.*$/",
            ],
        },
        {
            "groupName": "terraform",
            "matchDepNames": [
                "/^hashicorp/terraform$/",
                "/^terraform$/",
            ],
        },
        {
            "groupName": "uv",
            "matchDepNames": [
                "/^astral-sh/setup-uv$/",
                "/^astral-sh/uv$/",
                "/^astral-sh/uv-pre-commit$/",
                "/^ghcr\\.io/astral-sh/uv$/",
            ],
        },
    ],
}
