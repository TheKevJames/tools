{
  "name": "required-checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "dependency-review"},
          {"context": "docker-atc1441 / build"},
          {"context": "docker-caddy-security / build"},
          {"context": "docker-fava / build"},
          {"context": "docker-gcloud-pubsub-emulator / build"},
          {"context": "docker-mysqltuner / build"},
          {"context": "docker-tuning-primer / build"},
          {"context": "lint"},
          {"context": "test-atc1441"},
          {"context": "test-gha"},
          {"context": "test-task"},
          {"context": "wip"}
        ]
      }
    }
  ]
}
