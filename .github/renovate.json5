{
    "extends": [
        "github>thekevjames/tools:personal",
        "github>thekevjames/tools//renovate/version-as-app.json5",
    ],
    "packageRules": [
        {
            "matchManagers": ["dockerfile"],
            "matchDepNames": [
                "library/caddy",
            ],
            "matchUpdateTypes": ["minor"],
            "automerge": true,
        },
    ],
}
